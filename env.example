# Конфигурация Kcell RAG Bot
# Скопируйте этот файл в .env и заполните реальными значениями
# НЕ КОММИТЬТЕ .env ФАЙЛ В РЕПОЗИТОРИЙ!

# ==========================================
# TELEGRAM BOT CONFIGURATION
# ==========================================

# Токен Telegram бота (получить у @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ==========================================
# DATABASE CONFIGURATION
# ==========================================

# Путь к директории с документами
DOCS_DIR=/Users/your_username/PycharmProjects/kcell rag kae/база данных документов

# Путь к векторной базе данных
DB_DIR=/Users/your_username/PycharmProjects/kcell rag kae/chroma_db

# ==========================================
# AI MODEL CONFIGURATION
# ==========================================

# Модель для генерации ответов (через Ollama)
GENERATION_MODEL=llama3.1:8b

# Модель для векторизации текста
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ==========================================
# SECURITY CONFIGURATION
# ==========================================

# Разрешенные пользователи Telegram (ID через запятую)
# Получить ID: написать боту @userinfobot
ALLOWED_USER_IDS=123456789,987654321

# ==========================================
# PERFORMANCE CONFIGURATION
# ==========================================

# Размер LRU кэша для ответов
CACHE_SIZE=200

# Путь к файлу аналитики использования
ANALYTICS_LOG=analytics/usage.log

# ==========================================
# RATE LIMITING
# ==========================================

# Окно rate limiting в секундах
RATE_LIMIT_WINDOW_SEC=5

# Максимум сообщений в окне
RATE_LIMIT_MAX=5

# ==========================================
# OPTIONAL: EXTERNAL API KEYS
# ==========================================

# Резервный API ключ для Google Gemini (если Ollama недоступен)
# GOOGLE_API_KEY=your_google_api_key_here

# ==========================================
# DEVELOPMENT SETTINGS
# ==========================================

# Режим отладки (true/false)
DEBUG=false

# Уровень логирования (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
